# Database connection string
# Local default (Docker / local PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/releasecheck
# Production example (e.g. Neon, Supabase, Render):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Backend Server Port (defaults to 4000)
PORT=4000
